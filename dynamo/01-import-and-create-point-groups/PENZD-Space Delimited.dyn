      ],
      "Replication": "Disabled",
      "Description": "Creates a string.",
      "InputValue": " "
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport clr\r\nimport os\r\n\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom Autodesk.Civil.DynamoNodes import *\r\nfrom DSCore import *\r\n\r\nls = IN[0]\r\nn = IN[1]    # Indices\r\ndoc = IN[2]\r\nfn = IN[3]\r\n\r\nall_point_groups = []\r\n\r\nfor i in n:\r\n    try:\r\n        pts = []\r\n        \r\n        lsn = List.Transpose(List.GetItemAtIndex(ls, i))\r\n        \r\n        px = List.GetItemAtIndex(lsn, 1)   # Easting\r\n        py = List.GetItemAtIndex(lsn, 2)   # Northing\r\n        pz = List.GetItemAtIndex(lsn, 3)   # Elevation\r\n        pd = List.GetItemAtIndex(lsn, 4)   # Description \r\n        \r\n        full_path = List.GetItemAtIndex(fn, i)\r\n        \r\n        if full_path:\r\n            file_name = os.path.splitext(os.path.basename(full_path))[0]\r\n        else:\r\n            file_name = \"Group_\" + str(i)\r\n        \r\n        for pxs, pys, pzs, pds in zip(px, py, pz, pd):\r\n            \r\n            geom = Point.ByCoordinates(pxs, pys, pzs)\r\n            \r\n            val_text = str(pds) if pds else \"\"\r\n            \r\n            new_pt = CogoPoint.ByGeometry(\r\n                geom,       # point\r\n                \"0\",        # layerName\r\n                doc,        # document\r\n                val_text,\r\n                val_text    # rawDescription\r\n            )\r\n            \r\n            pts.append(new_pt)\r\n        \r\n        if len(pts) > 0:\r\n            ptsgr = CogoPointGroup.ByCogoPoints(pts, file_name, doc, \"Created via Dynamo\")\r\n            \r\n            all_point_groups.append(ptsgr)\r\n        else:\r\n            all_point_groups.append(\"Warning: No points in file \" + file_name)\r\n            \r\n    except Exception as e:\r\n        all_point_groups.append(\"Error in file index {0}: {1}\".format(i, str(e)))\r\n\r\nOUT = all_point_groups",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "72264092ff5745479e2b85bed19c8603",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "733d2101579c4414bc78bcbf0923e3c8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4a751c4055ee4096aac93441576cb44f",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
