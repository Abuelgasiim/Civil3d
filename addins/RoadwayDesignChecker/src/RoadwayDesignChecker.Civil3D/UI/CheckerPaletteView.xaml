<UserControl x:Class="RoadwayDesignChecker.Civil3D.UI.CheckerPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E222A"
             Foreground="#E8EEF7"
             FontFamily="Segoe UI"
             FontSize="12.5">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BgSurface" Color="#1E222A"/>
    <SolidColorBrush x:Key="BgCard" Color="#262C36"/>
    <SolidColorBrush x:Key="BgInput" Color="#191D24"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#374151"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="StatusFail" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusWarn" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusPass" Color="#22C55E"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="Foreground" Value="#E8EEF7"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#161A21" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,10">
      <DockPanel>
        <Button x:Name="BtnRunCheckTop" DockPanel.Dock="Right" Content="Check Roadway" Style="{StaticResource PrimaryButton}" Click="OnRunCheckClick"/>
        <StackPanel>
          <TextBlock Text="Roadway Design Checker" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="Plain-English Civil 3D Review · SHC 301 &amp; AASHTO 2018" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main Tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource BgSurface}" BorderThickness="0" Padding="0">

      <!-- TAB 1: DESIGN REVIEW -->
      <TabItem Header="1. Design Review">
        <Grid Background="{StaticResource BgSurface}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Road & Standard Setup (Collapsible) -->
          <Expander x:Name="SetupExpander" Grid.Row="0" Header="Roadway &amp; Design Standard Setup" IsExpanded="True"
                    Foreground="#E8EEF7" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Margin="0,6,0,4">
              <!-- Alignment + Pick + Refresh -->
              <TextBlock Text="Road Alignment" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbAlignment" Grid.Column="0" DisplayMemberPath="Name" SelectionChanged="OnAlignmentSelectionChanged" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Pick" ToolTip="Pick Alignment in Civil 3D Drawing" Style="{StaticResource SecondaryButton}" Click="OnPickAlignmentClick" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="Refresh" ToolTip="Reload Alignments from Drawing" Style="{StaticResource SecondaryButton}" Click="OnRefreshDrawingClick"/>
              </Grid>

              <!-- Profile & Design Code -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Vertical Profile" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbProfile" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Design Code" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbStandard" DisplayMemberPath="DisplayName" SelectionChanged="OnStandardSelectionChanged"/>
                </StackPanel>
              </Grid>

              <!-- Road Type, Terrain, Max Cross-Slope -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Roadway Class" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbRoadClass">
                    <ComboBoxItem Content="Freeway / Expressway" Tag="FreewayExpressway" IsSelected="True"/>
                    <ComboBoxItem Content="Arterial" Tag="Arterial"/>
                    <ComboBoxItem Content="Collector" Tag="Collector"/>
                    <ComboBoxItem Content="Local Street" Tag="Local"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Terrain" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbTerrain">
                    <ComboBoxItem Content="Level" Tag="Level" IsSelected="True"/>
                    <ComboBoxItem Content="Rolling" Tag="Rolling"/>
                    <ComboBoxItem Content="Mountainous" Tag="Mountainous"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Max Tilt e" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="CmbEmax">
                    <ComboBoxItem Content="4%" Tag="4"/>
                    <ComboBoxItem Content="6%" Tag="6" IsSelected="True"/>
                    <ComboBoxItem Content="8%" Tag="8"/>
                    <ComboBoxItem Content="10%" Tag="10"/>
                    <ComboBoxItem Content="12%" Tag="12"/>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <!-- Fallback Speed, Lateral Sight Offset M, Optional XML -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Fallback Speed (km/h)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="TxtFallbackSpeed" Text="100" Background="{StaticResource BgInput}" Foreground="#E8EEF7" BorderBrush="{StaticResource BorderSubtle}" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Inside Clearance M (m)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="TxtLateralM" Text="5.0" Background="{StaticResource BgInput}" Foreground="#E8EEF7" BorderBrush="{StaticResource BorderSubtle}" Padding="6,4"/>
                </StackPanel>
                <Button Grid.Column="4" VerticalAlignment="Bottom" Content="Load XML..." ToolTip="Load Autodesk Civil 3D Roadway Design Standards XML" Style="{StaticResource SecondaryButton}" Click="OnLoadXmlClick"/>
              </Grid>

              <WrapPanel Margin="0,4,0,0">
                <CheckBox x:Name="ChkHoriz" Content="Horizontal" IsChecked="True" Foreground="#E8EEF7" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkVert" Content="Vertical" IsChecked="True" Foreground="#E8EEF7" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkSight" Content="Visibility (SSD)" IsChecked="True" Foreground="#E8EEF7" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkPsd" Content="2-Lane Passing (PSD)" IsChecked="False" Foreground="#E8EEF7"/>
              </WrapPanel>
            </StackPanel>
          </Expander>

          <!-- Plain-English Summary & Status Filter Buttons -->
          <Border Grid.Row="1" Background="#222731" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
              <TextBlock x:Name="TxtSummaryHeadline" Text="Select an Alignment and click 'Check Roadway' to start." FontWeight="SemiBold" TextWrapping="Wrap"/>
              <UniformGrid Columns="4" Margin="0,8,0,0">
                <Button x:Name="BtnFilterAll" Content="All (0)" Style="{StaticResource SecondaryButton}" Click="OnStatusFilterClick" Tag="ALL" Margin="0,0,4,0"/>
                <Button x:Name="BtnFilterFail" Content="Needs Fix (0)" Style="{StaticResource SecondaryButton}" Foreground="#FCA5A5" Click="OnStatusFilterClick" Tag="FAIL" Margin="0,0,4,0"/>
                <Button x:Name="BtnFilterWarn" Content="Advisory (0)" Style="{StaticResource SecondaryButton}" Foreground="#FCD34D" Click="OnStatusFilterClick" Tag="WARN" Margin="0,0,4,0"/>
                <Button x:Name="BtnFilterPass" Content="Passed (0)" Style="{StaticResource SecondaryButton}" Foreground="#86EFAC" Click="OnStatusFilterClick" Tag="PASS"/>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- Search & Topic Filter -->
          <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
              <ComboBox x:Name="CmbCategoryFilter" DockPanel.Dock="Right" Width="135" SelectionChanged="OnCategoryFilterChanged" Margin="6,0,0,0">
                <ComboBoxItem Content="All Topics" Tag="ALL" IsSelected="True"/>
                <ComboBoxItem Content="Horizontal" Tag="HorizontalAlignment"/>
                <ComboBoxItem Content="Vertical" Tag="VerticalProfile"/>
                <ComboBoxItem Content="Visibility" Tag="SightDistance"/>
              </ComboBox>
              <TextBox x:Name="TxtSearch" TextChanged="OnSearchTextChanged" Background="{StaticResource BgInput}" Foreground="#E8EEF7"
                       BorderBrush="{StaticResource BorderSubtle}" Padding="6,4" ToolTip="Filter by station, curve name, or keyword"/>
            </DockPanel>
          </Border>

          <!-- Plain-English Audit Cards List -->
          <ListBox x:Name="FindingsList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnFindingSelectionChanged"
                   MouseDoubleClick="OnFindingDoubleClick"
                   Padding="8">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="5"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Severity Stripe -->
                    <Border Grid.Column="0" Background="{Binding SeverityBrush}" CornerRadius="3" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <!-- Badge + Category + Show on Drawing button -->
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Show on Drawing" FontSize="11" Padding="8,3"
                                Style="{StaticResource SecondaryButton}" Tag="{Binding Result}" Click="OnZoomCardClick"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding SeverityBrush}" FontSize="11" FontWeight="Bold"/>
                          </Border>
                          <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DockPanel>

                      <!-- Plain-English Headline & Location -->
                      <TextBlock Text="{Binding Headline}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,2"/>
                      <TextBlock Text="{Binding LocationAndSpeed}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>

                      <!-- Clear 3-Column Comparison Box -->
                      <Border Background="{StaticResource BgInput}" CornerRadius="5" Padding="8,6" Margin="0,8,0,0">
                        <UniformGrid Columns="3">
                          <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Your Drawing Has" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding YourDrawingText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Standard Requires" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding StandardRequiresText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="Result" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding DifferenceText}" Foreground="{Binding SeverityBrush}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                          </StackPanel>
                        </UniformGrid>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Selected Finding Plain-English Coach Drawer -->
          <Border x:Name="CoachDrawer" Grid.Row="4" Background="#161A21" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,10" Visibility="Collapsed">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Zoom Station" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11.5" Click="OnZoomSelectedClick"/>
                <TextBlock x:Name="TxtCoachHeadline" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>

              <ProgressBar x:Name="BarCompliance" Height="6" Minimum="0" Maximum="100" Value="100" Margin="0,0,0,8"/>

              <TextBlock Text="WHY THIS MATTERS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
              <TextBlock x:Name="TxtWhyItMatters" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"/>

              <TextBlock Text="HOW TO FIX IT IN CIVIL 3D" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
              <TextBlock x:Name="TxtHowToFix" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,6"/>

              <TextBlock x:Name="TxtTechnicalRef" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>

              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save Note" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="OnSaveNoteClick"/>
                <TextBox x:Name="TxtEngineerNote" Background="{StaticResource BgInput}" Foreground="#E8EEF7" BorderBrush="{StaticResource BorderSubtle}"
                         Padding="6,4" ToolTip="Optional engineer waiver or review note included in exported reports"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 2: DESIGN VALUES TABLE -->
      <TabItem Header="2. Design Values">
        <Grid Background="{StaticResource BgSurface}" Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TxtStandardDetails" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel>
              <Button Content="Load Override JSON..." Style="{StaticResource SecondaryButton}" Click="OnLoadOverrideClick" Margin="0,0,6,4"/>
              <Button Content="Save Custom JSON..." Style="{StaticResource PrimaryButton}" Click="OnSaveOverrideClick" Margin="0,0,6,4"/>
              <Button Content="Reset Overrides" Style="{StaticResource SecondaryButton}" Click="OnResetOverridesClick" Margin="0,0,6,4"/>
            </WrapPanel>
          </StackPanel>

          <DataGrid x:Name="GridSpeedTable" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="{StaticResource BgCard}" Foreground="#111827" RowBackground="#F8FAFC" AlternatingRowBackground="#EEF2F7"
                    GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Speed (km/h)" Binding="{Binding DesignSpeedKph}" IsReadOnly="True" Width="85"/>
              <DataGridTextColumn Header="Min Radius e=6% (m)" Binding="{Binding MinRadius6}" Width="120"/>
              <DataGridTextColumn Header="Min Radius e=8% (m)" Binding="{Binding MinRadius8}" Width="120"/>
              <DataGridTextColumn Header="Min Spiral Ls (m)" Binding="{Binding MinSpiralLengthM}" Width="105"/>
              <DataGridTextColumn Header="Desirable Grade (%)" Binding="{Binding MaxDesirableGradePercent}" Width="120"/>
              <DataGridTextColumn Header="Max Grade (%)" Binding="{Binding MaxAllowableGradePercent}" Width="95"/>
              <DataGridTextColumn Header="Crest K" Binding="{Binding MinCrestKSsd}" Width="65"/>
              <DataGridTextColumn Header="Sag K" Binding="{Binding MinSagK}" Width="60"/>
              <DataGridTextColumn Header="SSD (m)" Binding="{Binding StoppingSightDistanceLevelM}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- TAB 3: EXPORT REVIEW SHEET -->
      <TabItem Header="3. Export Report">
        <StackPanel Background="{StaticResource BgSurface}" Margin="14">
          <TextBlock Text="Generate Human-Readable QA/QC Review Sheet" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="Export the latest roadway review with plain-English explanations, fix guidance, technical SHC 301 / AASHTO references, and your engineer notes."
                     Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <CheckBox x:Name="ChkIncludePassed" Content="Include Passed checks in exported report" IsChecked="True" Foreground="#E8EEF7" Margin="0,0,0,14"/>

          <Button Content="Export Formatted Review Sheet (.html)" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Width="280" Margin="0,0,0,8" Click="OnExportHtmlClick"/>
          <Button Content="Export Excel / CSV Table (.csv)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="280" Margin="0,0,0,8" Click="OnExportCsvClick"/>
          <Button Content="Export Structured Findings (.json)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="280" Click="OnExportJsonClick"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Status Bar -->
    <Border Grid.Row="2" Background="#161A21" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="10,5">
      <TextBlock x:Name="TxtStatusBar" Text="Ready — SHC 301 &amp; AASHTO 2018 criteria loaded." FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
    </Border>
  </Grid>
</UserControl>
