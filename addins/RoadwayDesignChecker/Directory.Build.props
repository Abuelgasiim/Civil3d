<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>RoadwayDesignChecker</Company>
    <Product>Civil 3D Roadway Design Checker (SHC 301 &amp; AASHTO)</Product>
    <Version>1.0.0</Version>

    <!-- Configure your local Civil 3D installation version (2025, 2026, or 2027) -->
    <Civil3dYear Condition="'$(Civil3dYear)' == ''">2026</Civil3dYear>
    <AutoCadInstallDir Condition="'$(AutoCadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD $(Civil3dYear)</AutoCadInstallDir>
    <Civil3dInstallDir Condition="'$(Civil3dInstallDir)' == ''">$(AutoCadInstallDir)\C3D</Civil3dInstallDir>
  </PropertyGroup>
</Project>
